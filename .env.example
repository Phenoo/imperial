# Emulator setup. Remove both emulator settings and replace the project and public
# settings with your Firebase web app config when deploying to your own Firebase project.
FIREBASE_PROJECT_ID=demo-imperial-pantry
FIRESTORE_EMULATOR_HOST=127.0.0.1:8685
FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9695
NEXT_PUBLIC_FIREBASE_PROJECT_ID=demo-imperial-pantry
NEXT_PUBLIC_FIREBASE_API_KEY=demo-imperial-pantry
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=demo-imperial-pantry.firebaseapp.com
NEXT_PUBLIC_FIREBASE_AUTH_EMULATOR_URL=http://127.0.0.1:9695
# Production: use Application Default Credentials or a secret environment variable
# containing the service account JSON. Never add the credential to NEXT_PUBLIC_*.
# FIREBASE_SERVICE_ACCOUNT_JSON=
# Public email displayed on the store policy pages
# STORE_SUPPORT_EMAIL=
# STORE_SUPPORT_WHATSAPP=
# STORE_PRIVACY_EMAIL=
# STORE_PUBLIC_URL=
# NEXT_PUBLIC_STORE_ANALYTICS=0
# NEXT_PUBLIC_GOOGLE_ANALYTICS_ID=
# GOOGLE_SITE_VERIFICATION=
# Enable public catalogue indexing independently of sandbox payments. Previews remain blocked.
# STORE_SEARCH_INDEXING=1
# STORE_LAGOS_DELIVERY_RULES={"freeFrom":75000,"island":{"fee":3000,"time":"1–2 business days"},"mainland":{"fee":3500,"time":"1–2 business days"},"outer":{"fee":5000,"time":"2–3 business days"}}
# STORE_URL=http://127.0.0.1:3640
# STORE_DEMO_CATALOG=1
# Paystack hosted checkout uses a server-only test secret key.
# PAYSTACK_SECRET_KEY=
# PAYSTACK_WEBHOOK_SECRET=
# Keep Bachs credentials to reconcile historical Bachs orders.
# BACHS_API_KEY=
# BACHS_WEBHOOK_SECRET=
# RESEND_API_KEY=
# STORE_ORDER_FROM=
